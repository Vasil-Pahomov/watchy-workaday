{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pio test:*)",
      "Bash(pio run:*)",
      "Bash(pio check:*)",
      "Bash(pio system info:*)",
      "Bash(pio pkg list:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "PowerShell(pio test:*)",
      "PowerShell(pio run:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Bash(pio run -t upload:*)",
      "PowerShell(pio run -t upload:*)"
    ]
  }
}
