{
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.intelliSenseEngine": "default",
  "editor.formatOnSave": true,
  "editor.rulers": [96],
  "files.associations": {
    "*.ino": "cpp",
    "platformio.ini": "ini"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "search.exclude": {
    "**/.pio/**": true
  },
  "files.watcherExclude": {
    "**/.pio/**": true
  }
}
