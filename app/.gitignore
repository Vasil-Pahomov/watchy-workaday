# Generated by Android Studio on first Sync — contains an absolute SDK path, so
# committing it would break Law 4 on every other machine.
local.properties

# Build output and Gradle's own state.
.gradle/
build/
.kotlin/
captures/

# IDE.
.idea/
*.iml

# Per-machine Claude Code state (permissions granted on this box only).
.claude/settings.local.json

# NDK / external native build output.
.cxx/
.externalNativeBuild/

# Packaged and signed artefacts — rebuilt from source, and keys never belong in git.
*.apk
*.aab
*.aar
*.keystore
*.jks
keystore.properties
signing.properties

# Editor and OS litter.
*.log
.DS_Store
Thumbs.db
