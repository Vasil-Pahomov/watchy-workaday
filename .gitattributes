# Store everything with LF in the repo; let Git pick the working-copy ending.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf

# Binary products and the Gradle wrapper jar.
*.jar binary
*.bin binary
*.elf binary

# Vendored TTFs and the checked-in preview renders are binary; do not let
# text=auto mangle them.
*.ttf binary
*.png binary
